# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── AbabilPay ────────────────────────────────────────────────────────────────
ABABILPAY_API_URL=https://testnetv1.ababilpay.xyz/api/v1
ABABILPAY_API_KEY=your-ababilpay-api-key
ABABILPAY_WEBHOOK_SECRET=your-webhook-secret

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# ─── Security ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── AI Agent (Buyer Agent + Vendor Auto-Quote) ───────────────────────────────
# Required for Phase 2+. Get key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional/Fallback: Google Gemini API Key
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Active fallback: Groq API Key (starts with gsk_) from https://console.groq.com/
GROQ_API_KEY=
# OpenRouter API Key
OPENROUTER_API_KEY=
# Provider Router Priority Configuration
PRIMARY_AI_PROVIDER=gemini
SECONDARY_AI_PROVIDER=groq
TERTIARY_AI_PROVIDER=openrouter


# ─── Telegram Bot (Phase 5) ───────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram to get this token
TELEGRAM_BOT_TOKEN=

# ─── Arc / Circle (Future — not needed for simulated escrow MVP) ──────────────
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_SET_ID=

